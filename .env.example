# graphix-bot environment variables.
# Copy this file to ".env" in the same folder as the "bot" package and fill in
# real values. Never commit the real .env - it holds secrets.

# --- Telegram ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# The one chat every notification goes to - the owner, or a staff group.
# Leave it blank the first time: the bot starts, answers /chatid from any
# chat with that chat's id, and drops events (loudly, in its log) until the
# id is here. A group's id is negative and starts with -100; paste it as shown.
TELEGRAM_CHAT_ID=

# --- the site ---
# The same value as WEBSITE_WEBHOOK_SECRET in the site's .env, and nowhere
# else. Generate it once with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBSITE_WEBHOOK_SECRET=

# --- listening (the defaults are right for the shared server) ---
# Loopback only: the site is on this same machine and nothing else should
# reach the bot. The site's .env then has
#   TELEGRAM_BOT_WEBHOOK_URL=http://127.0.0.1:8100/graphix/events
# BIND_HOST=127.0.0.1
# BIND_PORT=8100
# WEBHOOK_PATH=/graphix/events

# DEBUG logs every request line; INFO logs every event and its outcome.
# LOG_LEVEL=INFO
